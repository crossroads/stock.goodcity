<div class="row fixed_search_header items-search search-box ui">
  <div class="small-10 columns">
    {{focus-textfield
      name="searchText"
      id="searchText"
      placeholder=(t "search_min")
      value=searchText }}

    {{#if hasSearchText}}
      <i {{action "clearSearch"}}>{{fa-icon 'times-circle'}}</i>
    {{/if}}
  </div>

  <div class="small-2 columns filter-buttons">
    <div id="needs-response-filter" class="button expand filter-button-css {{if needsResponseTrue 'filter-button-border'}}" {{action "toggleOrderNeedsResponse"}} >
      <div class="button-text" title="Show orders that need replies">{{fa-icon 'comments' size="lg"}}</div>
    </div>
  </div>

  {{order-filter-buttons}}
</div>

<section class="main-section orders_search_result">
  <div class="row search">
    <div class="small-12 columns">
      <div class="small-12 columns">
        {{#if displayResults}}
          {{#infinite-list height="75vh" loadMore=(action "loadMoreOrders") as |items| }}
            <ul class="list list-activity list-offer-items">
              {{#each items as |order|}}
                {{#link-to 'orders.active_items' order.id href=false}}
                  {{goodcity/order-block order=order}}
                {{/link-to}}
              {{/each}}
            </ul>
          {{/infinite-list}}
        {{/if}}
      </div>
    </div>
  </div>
  {{sticky-footer}}
</section>
